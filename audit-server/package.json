{
  "name": "qualaces-audit",
  "version": "1.0.0",
  "description": "Passive website audit service: measures a public URL in a real browser and turns findings into a test strategy.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "E2E=1 node --test test/e2e.test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "axe-core": "4.10.2",
    "playwright-core": "1.52.0"
  }
}
